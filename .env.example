# Zenith-AI Fitness Application Environment Variables
# Copy this file to .env.local and fill in your actual values

# Google Gemini AI API Key (REQUIRED)
# Used for: Workout analysis, plan generation, and food image analysis
# Get your API key from: https://aistudio.google.com/app/apikey
# Used in: vite.config.ts, services/geminiService.ts
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Project URL (OPTIONAL but recommended)
# Used for: Authentication and database backend
# Get your URL from: https://app.supabase.com/project/_/settings/api
# Used in: services/supabaseClient.ts
# Default: https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Public Key (OPTIONAL but recommended)
# Used for: Client-side authentication and API access
# Get your key from: https://app.supabase.com/project/_/settings/api
# Used in: services/supabaseClient.ts
# Default: your-anon-key
SUPABASE_ANON_KEY=your-anon-key-here
